{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deviceharbor-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_ROOMS",
        "class_name": "DeviceHarborRelayRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeviceHarborRelayRoom"]
    }
  ]
}
